meta {
  name: Listar clientes
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/usuarios?rol=CLIENTE&page=0&size=5
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenAdmin}}
}

tests {
  test("responde 200 con una pagina de clientes", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().content).to.be.an("array");
  });
}
